{
  "name": "nemax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/start.js",
    "test:encryption": "node server/crypto-selftest.js",
    "dev:core": "node --watch server/index.js",
    "dev:realtime": "node --watch server/realtime.js",
    "server:realtime": "node --env-file-if-exists=.env server/realtime.js",
    "check": "node server/crypto-selftest.js && node server/platform-selftest.js && node server/game-server-selftest.js && node server/ai-server-selftest.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "backup": "node --env-file-if-exists=.env server/backup.js",
    "server:core": "node --env-file-if-exists=.env server/index.js",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "server:runner": "node --env-file-if-exists=.env server/code-runner.js",
    "dev:runner": "node --watch server/code-runner.js",
    "test:code-runner": "node server/code-runner-selftest.js",
    "test:games": "node server/game-server-selftest.js",
    "server:games": "node --env-file-if-exists=.env server/game-server.js",
    "dev:games": "node --watch server/game-server.js",
    "server:ai": "node --env-file-if-exists=.env server/ai-server.js",
    "dev:ai": "node --watch server/ai-server.js",
    "test:ai": "node server/ai-server-selftest.js",
    "test:ai-provider": "node --env-file-if-exists=.env scripts/test-ai-provider.js",
    "test:windows-runtimes": "node --env-file-if-exists=.env server/code-runner-selftest.js",
    "test:stockfish": "node --env-file-if-exists=.env server/game-server-selftest.js",
    "test:hotfix": "node --env-file-if-exists=.env server/windows-hotfix-selftest.js"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "@aws-sdk/client-s3": "^3.864.0",
    "web-push": "^3.6.7",
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1",
    "@capacitor/cli": "^7.4.3"
  }
}
