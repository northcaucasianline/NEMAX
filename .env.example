# Обязательные секреты
INTERNAL_SERVICE_SECRET=replace-with-64-random-characters
POSTGRES_PASSWORD=change-postgres-password
MINIO_ROOT_USER=messenger
MINIO_ROOT_PASSWORD=change-minio-password
GRAFANA_PASSWORD=change-grafana-password


# Первый системный администратор. Обязательно смените пароль перед публикацией.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!ChangeMe
BOOTSTRAP_ADMIN_NAME=Главный администратор
BOOTSTRAP_ADMIN_USERNAME=admin

# Core / Realtime
PORT=3001
HOST=0.0.0.0
REALTIME_PORT=3002
REALTIME_HOST=0.0.0.0
CORE_INTERNAL_URL=http://127.0.0.1:3001
REALTIME_INTERNAL_URL=http://127.0.0.1:3002
PUBLIC_ORIGIN=http://localhost,http://localhost:5173,https://localhost
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000
MESSAGE_RATE_LIMIT_PER_MINUTE=90
MAX_BODY_BYTES=31457280
MAX_UPLOAD_BYTES=2147483648
UPLOAD_CHUNK_BYTES=2097152
OFFLINE_EVENT_QUEUE_LIMIT=500
OFFLINE_EVENT_TTL_MS=604800000
BACKGROUND_JOB_INTERVAL_MS=1000



# Отдельный игровой сервер
GAME_SERVER_PORT=3004
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_INTERNAL_URL=http://127.0.0.1:3004
GAME_DATABASE_URL=
GAME_TICK_MS=500
GAME_RATE_LIMIT_PER_MINUTE=240
GAME_AUTH_CACHE_MS=15000
# VITE_GAME_API_URL=https://example.com/game-api

# Отдельный AI Companion Server
AI_SERVER_PORT=3005
AI_SERVER_HOST=127.0.0.1
AI_SERVER_INTERNAL_URL=http://127.0.0.1:3005
# demo = безопасные демонстрационные ответы без внешней модели
# ollama = локальная модель
# openai-compatible / polza = совместимый /v1/chat/completions API
# Для Polza.ai: AI_PROVIDER=polza, AI_API_BASE_URL=https://polza.ai/api/v1
AI_PROVIDER=demo
AI_MODEL=local-model
AI_API_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_MS=45000
AI_REPLY_TIMEOUT_MS=55000
AI_MAX_CONTEXT_MESSAGES=30
AI_MAX_OUTPUT_TOKENS=900
AI_MESSAGES_PER_MINUTE=12
AI_MAX_CONCURRENT=8

# Шахматный движок. Оставьте пустым для встроенного резервного бота.
# Windows пример: STOCKFISH_BIN=C:\\Tools\\stockfish\\stockfish-windows-x86-64-avx2.exe
# Также можно положить stockfish.exe в server/bin.
STOCKFISH_BIN=

# Пути к Python и JDK для Windows. Если команды доступны в PATH, оставьте пустыми.
# PYTHON_BIN=C:\\Users\\User\\AppData\\Local\\Programs\\Python\\Python313\\python.exe
# JAVA_HOME=C:\\Program Files\\Java\\jdk-21
PYTHON_BIN=
JAVA_HOME=
JAVA_BIN=
JAVAC_BIN=

# NEMAX Code Studio. В локальном npm run dev runner включается автоматически.
CODE_RUNNER_ENABLED=false
CODE_RUNNER_PORT=3003
CODE_RUNNER_HOST=127.0.0.1
CODE_RUNNER_INTERNAL_URL=http://127.0.0.1:3003
CODE_RUNNER_SOCKET=
CODE_RUNNER_TIMEOUT_MS=6000
CODE_RUNNER_MAX_SOURCE_BYTES=240000
CODE_RUNNER_MAX_OUTPUT_BYTES=96000
CODE_RUNNER_MAX_FILES=24
CODE_RUNNER_DISABLE_NETWORK=true
CODE_RUNNER_USE_PRLIMIT=true
CODE_RUNNER_CHILD_UID=0
CODE_RUNNER_CHILD_GID=0
CODE_RUNNER_SOCKET_GID=0

# Production storage
# Для простого локального запуска оставьте эти значения пустыми.
# Тогда НЕМАКС использует JSON-файл, память и папку server/uploads без спама ошибок.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=

# Примеры для запуска внешней инфраструктуры вручную:
# DATABASE_URL=postgresql://messenger:change-postgres-password@127.0.0.1:5432/messenger
# REDIS_URL=redis://127.0.0.1:6379
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=messenger-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=messenger
S3_SECRET_ACCESS_KEY=change-minio-password
S3_CREATE_BUCKET=true
REQUIRE_POSTGRES=false
REQUIRE_REDIS=false
REQUIRE_S3=false

# Web Push: сгенерируйте VAPID-ключи
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.local

# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_USERNAME=messenger
TURN_CREDENTIAL=change-this-turn-password

# Платежи: demo хранит локальные операции, реальный провайдер подключается отдельно

# Webhook ботов выключен по умолчанию; URL проверяется на private-network SSRF
ENABLE_BOT_WEBHOOKS=false

# Frontend
VITE_REALTIME_PORT=3002
# VITE_API_URL=https://example.com/api
# VITE_WS_URL=wss://example.com/ws

# Только для демонстрационного запуска
SEED_DEMO_USERS=false
